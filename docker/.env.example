# Forgejo MCP Stack — Environment Variables
# Copy to .env and fill in values before deploying

# URL of your self-hosted Forgejo instance
FORGEJO_URL=https://forgejo.yourdomain.com

# Personal Access Token from Forgejo → Settings → Applications
# Required scopes: repo, issue, user
FORGEJO_ACCESS_TOKEN=your_forgejo_pat_here

# Enable debug logging (true/false)
FORGEJO_DEBUG=false

# Host port to expose the SSE MCP endpoint on
# Connect your MCP client to: http://<host>:<port>/sse
FORGEJO_MCP_PORT=8089
